{
  "name": "devflow-web-terminal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build:portable": "node scripts/build.js",
    "test:server": "node --test \"server/test/*.test.js\"",
    "test:web": "npm --prefix web run test",
    "test": "npm run test:server && npm run test:web",
    "typecheck": "npm --prefix web run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
